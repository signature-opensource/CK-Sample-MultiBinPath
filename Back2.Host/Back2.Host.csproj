<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The two hosts share one builder (CK.AppHost expects "Back2.Builder" otherwise). -->
    <CKAppHostBuilder>Backs.Builder</CKAppHostBuilder>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bootstrap of the host (Program.cs) and the conventions of the host project. -->
    <PackageReference Include="CK.AppHost" Version="24.0.0-0.cris-auth.1.ci.39" />
    <ProjectReference Include="..\Back2.App\Back2.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Backs.Builder\Backs.Builder.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
</Project>